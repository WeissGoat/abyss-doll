{
  "mcpServers": {
    "unityMCP": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--offline",
        "--from",
        "mcpforunityserver==10.0.0",
        "mcp-for-unity",
        "--transport",
        "stdio"
      ],
      "env": {
        "DISABLE_TELEMETRY": "1",
        "UNITY_MCP_DISABLE_TELEMETRY": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    }
  }
}
