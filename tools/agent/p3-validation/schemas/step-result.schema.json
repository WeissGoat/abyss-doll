{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p3-validation/step-result@1",
  "type": "object",
  "required": ["schema_version", "run_id", "profile_id", "step_id", "required", "status", "artifacts"],
  "properties": {
    "schema_version": { "const": "p3-validation/step-result@1" },
    "run_id": { "type": "string", "minLength": 1 },
    "profile_id": { "type": "string", "minLength": 1 },
    "step_id": { "type": "string", "minLength": 1 },
    "required": { "type": "boolean" },
    "status": { "enum": ["Passed", "Failed", "Blocked", "Limited", "Cancelled"] },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }
  },
  "$defs": { "artifact": { "type": "object", "required": ["path", "source_path", "sha256", "size", "captured_at", "mime_type"], "properties": { "path": { "type": "string" }, "source_path": { "type": "string" }, "sha256": { "type": "string" }, "size": { "type": "integer", "minimum": 0 }, "captured_at": { "type": "string" }, "mime_type": { "type": "string" } } } }
}
