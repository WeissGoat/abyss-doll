{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p3-validation/summary@1",
  "type": "object",
  "required": ["schema_version", "run_id", "profile_id", "automation_status", "owner_validation", "external_review", "claim_ceiling"],
  "properties": {
    "schema_version": { "const": "p3-validation/summary@1" },
    "run_id": { "type": "string", "minLength": 1 },
    "profile_id": { "type": "string", "minLength": 1 },
    "automation_status": { "enum": ["Passed", "Failed", "Blocked", "Limited", "Cancelled"] },
    "owner_validation": { "enum": ["NotStarted", "Required", "Passed", "Failed"] },
    "external_review": { "enum": ["NotRequired", "Required", "Passed", "Failed"] },
    "claim_ceiling": { "enum": ["evidence_collected", "automation_passed", "owner_validated", "externally_reviewed"] }
  }
}
